<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HyTrack Complete Prototype</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;800;900&family=Pacifico&display=swap" rel="stylesheet">
    <style>
        body { 
            font-family: 'Inter', sans-serif; 
            background: linear-gradient(135deg, #e0e7ff 0%, #f8fafc 100%);
            display: flex; justify-content: center; align-items: center; 
            height: 100vh; margin: 0;
        }
        .phone-frame {
            width: 375px; height: 812px; 
            background: #ffffff; 
            border-radius: 48px; position: relative; overflow: hidden;
            box-shadow: 0 25px 50px -12px rgba(30, 58, 138, 0.25), 0 0 0 12px #0f172a;
        }
        .font-script { font-family: 'Pacifico', cursive; }
        .hide-screen { display: none !important; }
        
        /* Smooth fade-in animation */
        .screen { 
            width: 100%; height: 100%; position: absolute; top: 0; left: 0; 
            overflow-y: auto; background: #ffffff; padding-bottom: 90px;
            animation: fadeIn 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        /* Hide scrollbar for cleaner look */
        .screen::-webkit-scrollbar { display: none; }
        .screen { -ms-overflow-style: none; scrollbar-width: none; }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Active Faucet Pulse Animation */
        @keyframes pulse-ring {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.5); }
            70% { transform: scale(1.05); box-shadow: 0 0 0 25px rgba(59, 130, 246, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(59, 130, 246, 0); }
        }
        .faucet-on-anim {
            animation: pulse-ring 2s infinite cubic-bezier(0.4, 0, 0.2, 1);
            background: linear-gradient(145deg, #eff6ff, #dbeafe) !important;
            border-color: #60a5fa !important;
        }
        .text-glow {
            text-shadow: 0 4px 20px rgba(59,130,246,0.6);
        }
        
        /* Animated Water Wave */
        @keyframes wave-flow {
            0% { background-position-x: 0; }
            100% { background-position-x: 1440px; }
        }
        .water-wave {
            position: absolute; bottom: 0; left: 0; width: 100%; height: 140px;
            background: url('data:image/svg+xml;utf8,<svg viewBox="0 0 1440 320" xmlns="http://www.w3.org/2000/svg"><path fill="%233b82f6" fill-opacity="0.15" d="M0,160L48,170.7C96,181,192,203,288,197.3C384,192,480,160,576,165.3C672,171,768,213,864,213.3C960,213,1056,171,1152,149.3C1248,128,1344,128,1392,128L1440,128L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path><path fill="%233b82f6" fill-opacity="0.4" d="M0,256L48,245.3C96,235,192,213,288,213.3C384,213,480,235,576,224C672,213,768,171,864,170.7C960,171,1056,213,1152,224C1248,235,1344,213,1392,202.7L1440,192L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path></svg>') repeat-x bottom;
            background-size: 1440px 140px; pointer-events: none;
            animation: wave-flow 12s linear infinite;
        }

        /* Hide Number Input Spinners */
        input[type=number]::-webkit-inner-spin-button, 
        input[type=number]::-webkit-outer-spin-button { 
            -webkit-appearance: none; margin: 0; 
        }

        /* Custom Input Styling */
        .glass-input {
            background: rgba(255, 255, 255, 0.9);
            border: 1px solid rgba(148, 163, 184, 0.2);
            transition: all 0.3s ease;
        }
        .glass-input:focus {
            background: #ffffff;
            border-color: #3b82f6;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
        }
        
        .fade-transition { transition: opacity 0.3s ease; }

        /* Notification Badge */
        .notif-badge {
            position: absolute;
            top: 6px;
            right: 10px;
            min-width: 18px;
            height: 18px;
            padding: 0 6px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            font-size: 10px;
            font-weight: 900;
            background: #ef4444;
            color: #fff;
            border: 2px solid rgba(255,255,255,0.95);
            box-shadow: 0 10px 20px rgba(239,68,68,0.25);
        }
        .hide-badge { display: none !important; }
    </style>
</head>
<body onload="initApp()">

<div class="phone-frame">

    <div id="view-login" class="screen flex flex-col items-center justify-center p-8 z-20 bg-slate-50">
        <div class="bg-gradient-to-br from-blue-600 to-indigo-900 rounded-[2rem] w-28 h-28 flex items-center justify-center mb-6 shadow-2xl shadow-blue-500/30 transform hover:scale-105 transition duration-300">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 12V2h12v4M21 6H12v2M12 12a5 5 0 0 0 10 0M12 16v3M8 20a1 1 0 0 1 8 0" /></svg>
        </div>
        <h1 class="text-4xl font-script text-slate-800 mb-2">HyTrack</h1>
        <p class="text-xs font-semibold text-slate-500 tracking-widest uppercase mb-10">Smart Water Monitor</p>
        
        <div class="w-full space-y-4 relative z-10">
            <div id="error-toast" class="hide-screen absolute inset-x-0 -top-16 bg-white border-l-4 border-red-500 rounded-xl p-3 shadow-xl z-50 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <div class="bg-red-100 text-red-500 w-6 h-6 rounded-full flex items-center justify-center font-bold text-xs">!</div>
                    <p class="text-slate-700 font-bold text-[10px] uppercase">WRONG PASSWORD!</p>
                </div>
                <button onclick="hideError()" class="text-slate-400 hover:text-red-500">✕</button>
            </div>

            <input type="text" placeholder="Username" class="w-full py-4 px-6 rounded-2xl glass-input text-slate-800 placeholder-slate-400 outline-none font-medium text-sm">
            <input type="password" id="pass-input" placeholder="Password" class="w-full py-4 px-6 rounded-2xl glass-input text-slate-800 placeholder-slate-400 outline-none font-medium text-sm">
            
            <div class="flex justify-end w-full">
                <p onclick="switchView('view-create')" class="text-blue-600 text-[11px] font-bold cursor-pointer hover:text-blue-800 transition mb-2">Create Account</p>
            </div>

            <button onclick="attemptLogin()" class="w-full py-4 bg-gradient-to-r from-blue-600 to-indigo-700 text-white font-black rounded-2xl shadow-lg shadow-blue-500/30 text-sm tracking-widest uppercase hover:opacity-90 active:scale-[0.98] transition-all">Log In</button>
        </div>
        <div class="water-wave opacity-60"></div>
    </div>

    <div id="view-create" class="screen hide-screen flex flex-col justify-center p-8 bg-slate-50 z-10">
        <button onclick="switchView('view-login')" class="absolute top-10 left-6 text-slate-400 font-bold text-xs flex items-center gap-1 hover:text-slate-800 transition"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg> Back</button>
        
        <h2 class="font-black text-2xl mb-2 text-slate-800">Sign Up</h2>
        <p class="text-xs font-medium text-slate-500 mb-8">Join HyTrack to monitor your usage.</p>
        
        <div class="w-full space-y-5 relative z-10">
            <div>
                <label class="text-[11px] font-bold text-slate-500 ml-1 mb-1.5 block uppercase tracking-wider">Email or Phone</label>
                <input type="text" class="w-full py-3.5 px-5 rounded-xl glass-input text-sm text-slate-800">
            </div>
            <div>
                <label class="text-[11px] font-bold text-slate-500 ml-1 mb-1.5 block uppercase tracking-wider">Create Password</label>
                <input type="password" class="w-full py-3.5 px-5 rounded-xl glass-input text-sm text-slate-800">
            </div>
            <div>
                <label class="text-[11px] font-bold text-slate-500 ml-1 mb-1.5 block uppercase tracking-wider">Confirm Password</label>
                <input type="password" class="w-full py-3.5 px-5 rounded-xl glass-input text-sm text-slate-800">
            </div>
            <button onclick="switchView('view-login')" class="w-full py-4 bg-slate-800 text-white font-black rounded-xl tracking-widest mt-4 shadow-lg active:scale-[0.98] text-xs uppercase hover:bg-slate-900 transition-all">Create Account</button>
        </div>
        <div class="water-wave opacity-50"></div>
    </div>

    <div id="view-dash" class="screen hide-screen bg-slate-50 p-6 pt-14">
        <header class="flex justify-between items-center mb-8">
            <div>
                <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-1">Welcome back</p>
                <h2 class="text-xl font-black text-slate-800">User Dashboard</h2>
            </div>
            <div class="bg-gradient-to-br from-blue-500 to-blue-700 w-10 h-10 rounded-full flex items-center justify-center shadow-md text-white font-bold cursor-pointer" onclick="switchView('view-profile')">U</div>
        </header>

        <div class="bg-gradient-to-br from-blue-600 to-indigo-700 p-7 rounded-[2rem] shadow-xl shadow-blue-500/20 text-white mb-4 relative overflow-hidden cursor-pointer transform hover:-translate-y-1 transition duration-300" onclick="switchView('view-billing')">
            <div class="absolute right-0 top-0 w-40 h-40 bg-white opacity-10 rounded-full blur-2xl transform translate-x-10 -translate-y-10"></div>
            
            <div class="flex justify-between items-start mb-2 relative z-10">
                <p class="text-[11px] font-bold uppercase tracking-widest opacity-80">Current Bill Limit</p>
                <span class="bg-white/20 px-2 py-1 rounded text-[9px] font-bold uppercase backdrop-blur-sm">Synced</span>
            </div>
            <h3 id="dash-bill-display" class="text-4xl font-black mb-6 relative z-10 tracking-tight truncate">₱ 0.00</h3>
            
            <div class="flex justify-between items-end border-t border-white/20 pt-4 relative z-10">
                <div>
                    <p class="text-[10px] font-bold uppercase opacity-80 mb-0.5">Total Consumption</p>
                    <p class="text-xl font-bold truncate max-w-[120px]"><span id="dash-consumption-display">0.00</span> <span class="text-xs font-medium opacity-80">m³</span></p>
                </div>
                <div class="bg-white/20 p-2 rounded-xl backdrop-blur-sm">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </div>
            </div>
        </div>

        <!-- Quick glance (new) -->
        <div class="bg-white rounded-[1.5rem] p-5 shadow-sm border border-slate-100 mb-6 relative z-10 cursor-pointer hover:shadow-md hover:border-blue-200 transition" onclick="switchView('view-notifications')">
            <div class="flex items-start justify-between gap-4">
                <div class="flex items-start gap-4">
                    <div class="bg-blue-50 w-10 h-10 rounded-full flex items-center justify-center shrink-0">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2">
                            <path d="M18 8a6 6 0 10-12 0c0 7-3 9-3 9h18s-3-2-3-9"/>
                            <path d="M13.73 21a2 2 0 01-3.46 0"/>
                        </svg>
                    </div>
                    <div>
                        <p class="text-[10px] font-bold text-blue-600 uppercase tracking-widest mb-1">Notifications</p>
                        <p id="dash-notif-summary" class="text-[11px] font-medium text-slate-600 leading-relaxed">No alerts right now.</p>
                    </div>
                </div>
                <div class="text-[10px] font-black text-slate-400 uppercase tracking-widest mt-1">View</div>
            </div>
        </div>

        <p class="text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-3 ml-1">Quick Controls</p>
        <div class="grid grid-cols-2 gap-4 mb-6 z-10 relative">
            <div class="bg-white p-5 rounded-[1.5rem] shadow-sm border border-slate-100 cursor-pointer hover:shadow-md hover:border-blue-200 transform hover:-translate-y-1 transition-all duration-300 group" onclick="switchView('view-faucet')">
                <div class="bg-blue-50 w-12 h-12 rounded-full flex items-center justify-center mb-3 group-hover:bg-blue-500 transition-colors duration-300">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-blue-600 group-hover:text-white transition-colors duration-300"><path d="M7 12V2h12v4M21 6H12v2M12 12a5 5 0 0 0 10 0M12 16v3M8 20a1 1 0 0 1 8 0" /></svg>
                </div>
                <h4 class="text-[11px] font-black text-slate-800 uppercase tracking-wide">Faucet</h4>
                <p class="text-[9px] text-slate-400 font-semibold mt-1">Remote Control</p>
            </div>
            
            <div class="bg-white p-5 rounded-[1.5rem] shadow-sm border border-slate-100 cursor-pointer hover:shadow-md hover:border-blue-200 transform hover:-translate-y-1 transition-all duration-300 group" onclick="switchView('view-set-limit')">
                <div class="bg-indigo-50 w-12 h-12 rounded-full flex items-center justify-center mb-3 group-hover:bg-indigo-500 transition-colors duration-300">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-indigo-600 group-hover:text-white transition-colors duration-300"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                </div>
                <h4 class="text-[11px] font-black text-slate-800 uppercase tracking-wide">Limits</h4>
                <p class="text-[9px] text-slate-400 font-semibold mt-1">Set Water Target</p>
            </div>
        </div>
        <div class="water-wave z-0 opacity-40"></div>
    </div>

    <div id="view-faucet" class="screen hide-screen bg-slate-50 flex flex-col items-center justify-center p-8 text-center transition-colors duration-500">
        <button onclick="switchView('view-dash')" class="absolute top-12 left-6 text-slate-400 font-bold text-xs flex items-center gap-1 hover:text-slate-800 transition z-20"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg> Back</button>
        
        <h4 class="absolute top-12 text-[12px] font-black text-slate-800 uppercase tracking-widest z-10">Smart Faucet</h4>
        
        <div id="faucet-circle" class="bg-white p-10 rounded-full shadow-2xl shadow-slate-200/50 w-64 h-64 flex flex-col items-center justify-center relative border-[10px] border-slate-50 mb-10 z-10 transition-all duration-500">
            <svg id="faucet-icon" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="transition-colors duration-500"><path d="M7 12V2h12v4M21 6H12v2M12 12a5 5 0 0 0 10 0M12 16v3M8 20a1 1 0 0 1 8 0" /></svg>
        </div>

        <div id="faucet-status-text" class="text-[11px] font-black text-slate-400 uppercase mb-5 tracking-[0.3em] z-10 transition-colors duration-300">SYSTEM: OFF</div>
        
        <label class="relative inline-flex items-center cursor-pointer scale-[1.7] z-10 shadow-sm rounded-full">
            <input type="checkbox" id="faucet-toggle" onchange="toggleFaucet(this)" class="sr-only peer">
            <div class="w-11 h-6 bg-slate-200 rounded-full peer peer-checked:bg-gradient-to-r peer-checked:from-blue-500 peer-checked:to-blue-600 after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:after:translate-x-full shadow-inner after:shadow-sm"></div>
        </label>
        
        <span id="on-off-label" class="mt-10 text-3xl font-black text-slate-800 uppercase z-10 transition-all duration-300 tracking-tight">OFF</span>
        
        <div class="mt-6 bg-white px-6 py-3 rounded-2xl shadow-sm border border-slate-100 z-10 flex items-center gap-3 cursor-pointer hover:border-blue-300 hover:shadow-md transition-all duration-300" onclick="switchView('view-set-limit')">
            <div class="bg-blue-50 p-1.5 rounded-full">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            </div>
            <span class="text-[11px] font-bold text-slate-600 uppercase tracking-wide">Target: <span id="faucet-limit-display" class="text-blue-600 font-black">0.00</span> m³</span>
        </div>

        <!-- Quick reminder shortcut (new) -->
        <div class="mt-3 bg-white px-6 py-3 rounded-2xl shadow-sm border border-slate-100 z-10 flex items-center gap-3 cursor-pointer hover:border-indigo-300 hover:shadow-md transition-all duration-300" onclick="switchView('view-notifications')">
            <div class="bg-indigo-50 p-1.5 rounded-full">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2">
                    <path d="M18 8a6 6 0 10-12 0c0 7-3 9-3 9h18s-3-2-3-9"/>
                    <path d="M13.73 21a2 2 0 01-3.46 0"/>
                </svg>
            </div>
            <span class="text-[11px] font-bold text-slate-600 uppercase tracking-wide">Open Alerts</span>
        </div>

        <div id="faucet-wave" class="water-wave z-0 grayscale opacity-20 transition-all duration-1000 h-[200px] background-size-[1440px_200px]"></div>
    </div>

    <div id="view-billing" class="screen hide-screen bg-slate-50 p-6 pt-14">
        <button onclick="switchView('view-dash')" class="absolute top-12 left-6 text-slate-400 font-bold text-xs flex items-center gap-1 hover:text-slate-800 transition"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg> Back</button>
        <h2 class="text-[12px] font-black text-slate-800 mb-8 text-center uppercase tracking-widest mt-1">Billing History</h2>
        
        <div class="space-y-4 relative z-10">
            <div class="bg-white p-5 rounded-[1.5rem] flex justify-between items-center shadow-sm border border-slate-100 hover:shadow-md transition">
                <div class="flex items-center gap-4">
                    <div class="bg-blue-50 text-blue-600 font-black text-xs px-3 py-2 rounded-xl">NOV</div>
                    <div>
                        <p class="text-sm font-bold text-slate-800">2025</p>
                        <p class="text-[10px] text-slate-400 font-semibold uppercase">Paid via GCash</p>
                    </div>
                </div>
                <span class="text-lg font-black text-blue-600">₱456.00</span>
            </div>

            <div class="bg-white p-5 rounded-[1.5rem] flex justify-between items-center shadow-sm border border-slate-100 hover:shadow-md transition">
                <div class="flex items-center gap-4">
                    <div class="bg-slate-50 text-slate-600 font-black text-xs px-3 py-2 rounded-xl">OCT</div>
                    <div>
                        <p class="text-sm font-bold text-slate-800">2025</p>
                        <p class="text-[10px] text-slate-400 font-semibold uppercase">Paid via Cash</p>
                    </div>
                </div>
                <span class="text-lg font-black text-slate-700">₱243.00</span>
            </div>

            <div class="bg-white p-5 rounded-[1.5rem] flex justify-between items-center shadow-sm border border-slate-100 hover:shadow-md transition">
                <div class="flex items-center gap-4">
                    <div class="bg-slate-50 text-slate-600 font-black text-xs px-3 py-2 rounded-xl">SEP</div>
                    <div>
                        <p class="text-sm font-bold text-slate-800">2025</p>
                        <p class="text-[10px] text-slate-400 font-semibold uppercase">Paid via Maya</p>
                    </div>
                </div>
                <span class="text-lg font-black text-slate-700">₱612.00</span>
            </div>
        </div>
        <div class="water-wave z-0 opacity-40"></div>
    </div>

    <div id="view-set-limit" class="screen hide-screen bg-slate-50 p-6 pt-14">
        <button onclick="switchView('view-dash')" class="absolute top-12 left-6 text-slate-400 font-bold text-xs flex items-center gap-1 hover:text-slate-800 transition z-20"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg> Back</button>
        <h2 class="text-[12px] font-black text-slate-800 mb-8 text-center uppercase tracking-widest mt-1">Water Target</h2>
        
        <div id="success-toast" class="hide-screen absolute left-6 right-6 top-24 bg-emerald-500 rounded-xl p-3 text-center shadow-lg shadow-emerald-500/30 z-50 transform transition-all duration-300">
            <p class="text-white font-bold text-[11px] uppercase tracking-wide">Limit successfully updated!</p>
        </div>

        <div class="bg-gradient-to-br from-indigo-500 to-blue-600 rounded-[2rem] p-7 text-white mb-6 shadow-xl shadow-blue-500/20 relative z-10 overflow-hidden">
            <div class="absolute -right-10 -top-10 w-40 h-40 bg-white/10 rounded-full blur-2xl"></div>
            
            <div class="flex items-center justify-between mb-8 relative z-10">
                <div class="bg-white/20 p-3 rounded-2xl backdrop-blur-md">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
                </div>
                <div class="text-right">
                    <p class="text-[10px] font-bold uppercase opacity-80 tracking-widest" id="current-month-display">Target Limit</p>
                    <p class="text-[13px] font-bold mt-0.5 whitespace-nowrap">Monthly Threshold</p>
                </div>
            </div>

            <div class="bg-white/10 rounded-3xl p-5 flex flex-col items-center justify-center backdrop-blur-md relative z-10 border border-white/20 shadow-inner w-full">
                <p class="text-[10px] font-bold uppercase tracking-widest mb-6 opacity-80">Adjust using buttons</p>
                
                <div class="flex items-center justify-center gap-3 mb-4 w-full">
                    <button onclick="adjustLimit(-0.5)" class="w-12 h-12 rounded-full bg-white/20 flex items-center justify-center text-3xl font-light hover:bg-white/30 active:scale-90 transition-all duration-200 shadow-sm shrink-0">-</button>
                    
                    <div class="flex items-end justify-center flex-1 border-b-2 border-white/30 pb-2 relative transition-all min-w-0">
                        <span id="currency-symbol" class="hide-screen text-xl font-bold mr-1 mb-1 opacity-90 fade-transition">₱</span>
