<script>
    // State Variables
    let currentLimitM3 = 15.00; 
    let currentConsumptionM3 = 0.00;  // NEW: tracked consumption
    let isPesoMode = false;

    // Notifications + settings (NEW)
    let faucetFlowInterval = null;
    let faucetReminderTimeout = null;

    const ALERT_LEVELS = [80, 95, 100]; // % of limit
    const DEFAULT_SETTINGS = {
        alertsEnabled: true,
        faucetReminderMinutes: 5
    };

    // --- FIXED WATER BILL COMPUTATION ---
    // The old version applied a fixed minimum charge (150) even for very small usage.
    // That is why 1.16 m³ was showing 200+ pesos and why the Notifications bill appeared "not changing".
    // This version starts from 0 and uses a simple tiered per-m³ rate so small usage scales correctly.
    // Adjust these rates to match your local water provider if needed.
    const WATER_TARIFF = {
        tiers: [
            { upTo: 10, rate: 50.00 },   // 0 - 10 m³
            { upTo: 20, rate: 55.00 },   // 10 - 20 m³
            { upTo: 30, rate: 60.00 },   // 20 - 30 m³
            { upTo: Infinity, rate: 70.00 } // 30+ m³
        ],
        fixedFee: 0.00 // set > 0 if your provider has a true fixed monthly fee
    };

    function calculateWaterBill(m3) {
        m3 = Math.max(0, Number(m3) || 0);

        let remaining = m3;
        let cost = WATER_TARIFF.fixedFee;

        let prevCap = 0;
        for (let i = 0; i < WATER_TARIFF.tiers.length; i++) {
            const tier = WATER_TARIFF.tiers[i];
            const cap = tier.upTo;
            const tierVolume = Math.max(0, Math.min(remaining, cap - prevCap));

            cost += tierVolume * tier.rate;

            remaining -= tierVolume;
            prevCap = cap;

            if (remaining <= 0) break;
        }

        return cost;
    }

    function calculateM3FromBill(targetPeso) {
        targetPeso = Math.max(0, Number(targetPeso) || 0);

        // With the fixed calculation, 0 peso corresponds to 0 m³ (no forced minimum).
        if (targetPeso <= calculateWaterBill(0)) return 0;

        // Binary search for an approximate m³ value that matches the target peso
        let low = 0, high = 500, mid = 0;
        for (let i = 0; i < 50; i++) {
            mid = (low + high) / 2;
            const cost = calculateWaterBill(mid);
            if (cost < targetPeso) low = mid;
            else high = mid;
        }
        return mid;
    }

    function initApp() {
        const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
        const d = new Date();
        document.getElementById("current-month-display").innerText = "For " + monthNames[d.getMonth()];

        var savedLimit = localStorage.getItem('hytrack_water_limit');
        if(savedLimit) {
            currentLimitM3 = parseFloat(savedLimit);
        } else {
            currentLimitM3 = 15.00; 
        }

        // NEW: load consumption
        var savedConsumption = localStorage.getItem('hytrack_consumption_m3');
        if(savedConsumption) {
            currentConsumptionM3 = parseFloat(savedConsumption);
        } else {
            currentConsumptionM3 = 0.00;
            localStorage.setItem('hytrack_consumption_m3', currentConsumptionM3.toFixed(2));
        }

        // NEW: initialize settings
        initSettings();

        updateDisplayValue();
        updateDashboardValues();
        document.getElementById('faucet-limit-display').innerText = currentLimitM3.toFixed(2);

        // NEW: render notifications UI state
        ensureSeedNotifications();
        checkThresholdsAndNotify(true);
        renderNotifications();
        updateNotificationBadge();
        updateNotificationsDashboardSummary();

        var savedFaucetState = localStorage.getItem('hytrack_faucet_on');
        if(savedFaucetState === 'true') {
            var toggle = document.getElementById('faucet-toggle');
            toggle.checked = true;
            toggleFaucet(toggle);
        }
    }

    // --- Function to sync Dashboard automatically ---
    function updateDashboardValues() {
        var dashBill = document.getElementById('dash-bill-display');
        var dashConsumption = document.getElementById('dash-consumption-display');
        
        if (dashBill && dashConsumption) {
            // Bill limit = estimated cost at target limit
            dashBill.innerText = "₱ " + calculateWaterBill(currentLimitM3).toFixed(2);
            // Consumption = tracked usage
            dashConsumption.innerText = currentConsumptionM3.toFixed(2);
        }

        // Update Notifications header metrics if present
        updateNotificationsHeader();
        updateNotificationsDashboardSummary();
    }

    // --- Function to auto-resize text so no scrolling happens ---
    function resizeInput() {
        var input = document.getElementById('limit-input');
        if (!input) return;
        if (input.value.length > 5) {
            input.classList.remove('text-3xl');
            input.classList.add('text-2xl');
        } else {
            input.classList.remove('text-2xl');
            input.classList.add('text-3xl');
        }
    }

    function updateDisplayValue() {
        var input = document.getElementById('limit-input');
        var unitLabel = document.getElementById('unit-label');
        var currencySymbol = document.getElementById('currency-symbol');
        var disclaimer = document.getElementById('computation-disclaimer');
        if (!input) return;
        
        if (isPesoMode) {
            input.value = calculateWaterBill(currentLimitM3).toFixed(2);
            unitLabel.innerText = "Estimated Cost (₱)";
            currencySymbol.classList.remove('hide-screen');
            disclaimer.classList.remove('hide-screen');
        } else {
            input.value = currentLimitM3.toFixed(2);
            unitLabel.innerText = "Cubic Meters (m³)";
            currencySymbol.classList.add('hide-screen');
            disclaimer.classList.add('hide-screen');
        }
        resizeInput();
    }

    function toggleCurrency() {
        manualInputUpdate(); 
        isPesoMode = !isPesoMode;
        updateDisplayValue();
    }

    function manualInputUpdate() {
        var input = document.getElementById('limit-input');
        if (!input) return;
        var val = parseFloat(input.value) || 0;
        
        if (isPesoMode) {
            currentLimitM3 = calculateM3FromBill(val);
        } else {
            currentLimitM3 = val;
        }
        
        if (currentLimitM3 < 0) currentLimitM3 = 0;
        resizeInput();
    }

    function adjustLimit(amount) {
        currentLimitM3 += amount;
        if (currentLimitM3 < 0) currentLimitM3 = 0; 
        updateDisplayValue();
    }

    function setLimit() {
        var limitValue = currentLimitM3.toFixed(2);
        localStorage.setItem('hytrack_water_limit', limitValue);
        
        document.getElementById('faucet-limit-display').innerText = limitValue;
        
        updateDashboardValues();

        // NEW: thresholds might change when limit changes
        resetThresholdFlags();
        checkThresholdsAndNotify(true);
        renderNotifications();
        updateNotificationBadge();
        
        var toast = document.getElementById('success-toast');
        toast.classList.remove('hide-screen');
        
        setTimeout(function() {
            toast.classList.add('hide-screen');
        }, 3000);
    }

    function switchView(targetId) {
        var allScreens = document.querySelectorAll('.screen');
        for (var i = 0; i < allScreens.length; i++) {
            allScreens[i].classList.add('hide-screen');
        }
        document.getElementById(targetId).classList.remove('hide-screen');
        
        var nav = document.getElementById('bottom-nav');
        if(targetId === 'view-login' || targetId === 'view-create') {
            nav.classList.add('hide-screen'); 
        } else {
            nav.classList.remove('hide-screen'); 
            updateNavState(targetId); 
        }

        // NEW: keep Notifications screen fresh
        if (targetId === 'view-notifications') {
            checkThresholdsAndNotify(true);
            renderNotifications();
            updateNotificationBadge();
            updateNotificationsHeader();
        }
    }

    function updateNavState(targetId) {
        // reset
        safeNavReset('nav-btn-dash');
        safeNavReset('nav-btn-notif');
        safeNavReset('nav-btn-contact');
        safeNavReset('nav-btn-profile');
        
        var faucetBtn = document.getElementById('nav-btn-faucet');
        faucetBtn.className = "p-5 bg-gradient-to-br from-blue-500 to-blue-700 text-white rounded-full shadow-lg shadow-blue-500/40 transition-transform hover:scale-105 active:scale-95 border-[6px] border-white";

        if(targetId === 'view-dash' || targetId === 'view-billing' || targetId === 'view-set-limit') {
            safeNavActivate('nav-btn-dash');
        } else if(targetId === 'view-notifications') {
            safeNavActivate('nav-btn-notif');
        } else if(targetId === 'view-contacts') {
            safeNavActivate('nav-btn-contact');
        } else if(targetId === 'view-profile' || targetId === 'view-about') {
            safeNavActivate('nav-btn-profile');
        } else if (targetId === 'view-faucet') {
            faucetBtn.classList.replace('from-blue-500', 'from-indigo-600');
            faucetBtn.classList.replace('to-blue-700', 'to-indigo-800');
            faucetBtn.classList.replace('shadow-blue-500/40', 'shadow-indigo-500/40');
        }
    }

    function safeNavReset(id) {
        var el = document.getElementById(id);
        if (!el) return;
        el.classList.remove('text-blue-600');
        el.classList.add('text-slate-400');
    }
    function safeNavActivate(id) {
        var el = document.getElementById(id);
        if (!el) return;
        el.classList.remove('text-slate-400');
        el.classList.add('text-blue-600');
    }

    function attemptLogin() {
        var pass = document.getElementById('pass-input').value;
        if(pass === "admin123" || pass === "") { 
            switchView('view-dash');
            hideError();
            document.getElementById('pass-input').value = ""; 
        } else {
            document.getElementById('error-toast').classList.remove('hide-screen');
        }
    }

    function hideError() {
        document.getElementById('error-toast').classList.add('hide-screen');
    }
    
    function logout() {
        // stop any simulation timers
        stopFaucetSimulation();
        switchView('view-login');
    }

    function toggleFaucet(checkbox) {
        var statusLabel = document.getElementById('faucet-status-text');
        var onOffText = document.getElementById('on-off-label');
        var faucetCircle = document.getElementById('faucet-circle');
        var faucetIcon = document.getElementById('faucet-icon');
        var faucetWave = document.getElementById('faucet-wave');
        
        if(checkbox.checked) {
            statusLabel.innerText = "SYSTEM: ACTIVE";
            statusLabel.className = "text-[11px] font-black text-blue-500 uppercase mb-5 tracking-[0.3em] z-10 transition-colors duration-300";
            
            onOffText.innerText = "FLOWING";
            onOffText.className = "mt-10 text-3xl font-black text-blue-600 uppercase z-10 text-glow transition-all duration-300 tracking-tight";
            
            faucetCircle.classList.add('faucet-on-anim');
            faucetCircle.classList.replace('border-slate-50', 'border-blue-100');
            faucetIcon.setAttribute('stroke', '#2563eb');
            
            faucetWave.classList.remove('grayscale', 'opacity-20');
            faucetWave.classList.add('opacity-80');

            localStorage.setItem('hytrack_faucet_on', 'true');

            // NEW: faucet reminders and usage simulation
            startFaucetSimulation();

            // NEW: immediate advisory notification
            addNotificationOncePerSession(
                'faucet-on',
                'Faucet is On',
                'Water is currently flowing. Turn off the faucet when not in use to avoid accidental over-consumption.',
                'info'
            );

        } else {
            statusLabel.innerText = "SYSTEM: OFF";
            statusLabel.className = "text-[11px] font-black text-slate-400 uppercase mb-5 tracking-[0.3em] z-10 transition-colors duration-300";
            
            onOffText.innerText = "OFF";
            onOffText.className = "mt-10 text-3xl font-black text-slate-800 uppercase z-10 transition-all duration-300 tracking-tight";
            
            faucetCircle.classList.remove('faucet-on-anim');
            faucetCircle.classList.replace('border-blue-100', 'border-slate-50');
            faucetIcon.setAttribute('stroke', '#94a3b8');

            faucetWave.classList.add('grayscale', 'opacity-20');
            faucetWave.classList.remove('opacity-80');

            localStorage.setItem('hytrack_faucet_on', 'false');

            // NEW
            stopFaucetSimulation();
        }

        updateNotificationBadge();
        updateNotificationsDashboardSummary();
    }

    // -----------------------------
    // NOTIFICATIONS SYSTEM (NEW)
    // -----------------------------
    function initSettings() {
        // alerts enabled
        var a = localStorage.getItem('hytrack_alerts_enabled');
        if (a === null) localStorage.setItem('hytrack_alerts_enabled', DEFAULT_SETTINGS.alertsEnabled ? 'true' : 'false');

        // faucet reminder minutes
        var m = localStorage.getItem('hytrack_faucet_reminder_min');
        if (m === null) localStorage.setItem('hytrack_faucet_reminder_min', String(DEFAULT_SETTINGS.faucetReminderMinutes));

        refreshSettingsUI();
    }

    function refreshSettingsUI() {
        var enabled = localStorage.getItem('hytrack_alerts_enabled') === 'true';
        var btn = document.getElementById('alerts-toggle-btn');
        if (btn) {
            btn.innerText = enabled ? 'On' : 'Off';
            btn.className = enabled
                ? "px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest bg-blue-600 text-white shadow-sm hover:opacity-90 active:scale-[0.98] transition"
                : "px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest bg-slate-200 text-slate-600 shadow-sm hover:bg-slate-300 active:scale-[0.98] transition";
        }

        var min = parseInt(localStorage.getItem('hytrack_faucet_reminder_min') || '5', 10);
        var label = document.getElementById('faucet-rem-min');
        if (label) label.innerText = String(min);
    }

    function toggleNotifSetting(key) {
        var current = localStorage.getItem(key) === 'true';
        localStorage.setItem(key, (!current).toString());
        refreshSettingsUI();

        addNotification(
            'settings',
            'Notification Settings Updated',
            (localStorage.getItem('hytrack_alerts_enabled') === 'true')
                ? 'Bill limit alerts are enabled. You will be notified as you approach your set threshold.'
                : 'Bill limit alerts are disabled. You can re-enable them anytime in Notifications.',
            'info'
        );
        renderNotifications();
        updateNotificationBadge();
        updateNotificationsDashboardSummary();
    }

    function cycleFaucetReminder() {
        var current = parseInt(localStorage.getItem('hytrack_faucet_reminder_min') || '5', 10);
        var options = [3, 5, 10, 15];
        var idx = options.indexOf(current);
        var next = options[(idx + 1) % options.length];
        localStorage.setItem('hytrack_faucet_reminder_min', String(next));
        refreshSettingsUI();

        addNotification(
            'settings',
            'Faucet Reminder Updated',
            'Faucet left-on reminders will trigger after ' + next + ' minutes of continuous flow.',
            'info'
        );
        renderNotifications();
        updateNotificationBadge();
    }

    function loadNotifications() {
        try {
            var raw = localStorage.getItem('hytrack_notifications');
            if (!raw) return [];
            var list = JSON.parse(raw);
            return Array.isArray(list) ? list : [];
        } catch(e) {
            return [];
        }
    }

    function saveNotifications(list) {
        localStorage.setItem('hytrack_notifications', JSON.stringify(list));
    }

    function addNotification(type, title, message, priority) {
        var list = loadNotifications();
        var item = {
            id: String(Date.now()) + "_" + Math.floor(Math.random() * 100000),
            ts: Date.now(),
            type: type || 'general',
            title: title || 'Notification',
            message: message || '',
            priority: priority || 'info',
            read: false
        };
        list.unshift(item);
        saveNotifications(list);
        updateNotificationBadge();
        updateNotificationsDashboardSummary();
    }

    // one-time per session helper (prevents spam when toggling faucet quickly)
    function addNotificationOncePerSession(key, title, message, priority) {
        var sessionKey = 'hytrack_session_once_' + key;
        if (sessionStorage.getItem(sessionKey) === 'true') return;
        sessionStorage.setItem(sessionKey, 'true');
        addNotification(key, title, message, priority || 'info');
    }

    function ensureSeedNotifications() {
        var list = loadNotifications();
        if (list.length > 0) return;

        addNotification(
            'welcome',
            'HyTrack Alerts Ready',
            'Set a monthly target, monitor usage, and receive reminders before your bill reaches the limit.',
            'info'
        );
        addNotification(
            'tip',
            'Water Saving Tip',
            'Turn off the faucet while brushing your teeth. This simple habit can reduce unnecessary consumption.',
            'info'
        );
    }

    function formatTime(ts) {
        var d = new Date(ts);
        var h = d.getHours();
        var m = d.getMinutes();
        var ap = h >= 12 ? 'PM' : 'AM';
        h = h % 12; if (h === 0) h = 12;
        var mm = (m < 10) ? ('0' + m) : m;
        return d.toLocaleDateString() + " - " + h + ":" + mm + " " + ap;
    }

    function renderNotifications() {
        var list = loadNotifications();
        var container = document.getElementById('notif-list');
        if (!container) return;

        if (list.length === 0) {
            container.innerHTML = '<div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 text-center text-slate-500 text-[12px] font-semibold">No notifications yet.</div>';
            return;
        }

        var html = '';
        for (var i = 0; i < list.length; i++) {
            var n = list[i];

            var color = 'border-slate-100';
            var dot = 'bg-slate-300';
            if (n.priority === 'warning') { color = 'border-amber-200'; dot = 'bg-amber-500'; }
            if (n.priority === 'danger') { color = 'border-red-200'; dot = 'bg-red-500'; }

            var unreadRing = n.read ? '' : 'ring-2 ring-blue-100';
            var opacity = n.read ? 'opacity-70' : 'opacity-100';

            html += ''
                + '<div class="bg-white p-5 rounded-2xl shadow-sm border ' + color + ' ' + unreadRing + ' ' + opacity + '">'
                + '  <div class="flex items-start justify-between gap-3">'
                + '    <div class="flex items-start gap-3">'
                + '      <div class="w-2.5 h-2.5 rounded-full mt-1.5 ' + dot + '"></div>'
                + '      <div>'
                + '        <p class="text-[12px] font-black text-slate-800">' + escapeHtml(n.title) + '</p>'
                + '        <p class="text-[11px] font-medium text-slate-600 leading-relaxed mt-1">' + escapeHtml(n.message) + '</p>'
                + '        <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest mt-3">' + formatTime(n.ts) + '</p>'
                + '      </div>'
                + '    </div>'
                + '    <button onclick="toggleRead(\'' + n.id + '\')" class="text-[10px] font-black uppercase tracking-widest text-blue-600 hover:text-blue-800 transition">'
                + (n.read ? 'Unread' : 'Read')
                + '    </button>'
                + '  </div>'
                + '</div>';
        }

        container.innerHTML = html;
        updateNotificationsHeader();
        refreshSettingsUI();
    }

    function toggleRead(id) {
        var list = loadNotifications();
        for (var i = 0; i < list.length; i++) {
            if (list[i].id === id) {
                list[i].read = !list[i].read;
                break;
            }
        }
        saveNotifications(list);
        renderNotifications();
        updateNotificationBadge();
        updateNotificationsDashboardSummary();
    }

    function markAllRead() {
        var list = loadNotifications();
        for (var i = 0; i < list.length; i++) list[i].read = true;
        saveNotifications(list);
        renderNotifications();
        updateNotificationBadge();
        updateNotificationsDashboardSummary();
    }

    function unreadCount() {
        var list = loadNotifications();
        var c = 0;
        for (var i = 0; i < list.length; i++) if (!list[i].read) c++;
        return c;
    }

    function updateNotificationBadge() {
        var badge = document.getElementById('notif-badge');
        if (!badge) return;

        var c = unreadCount();
        badge.innerText = String(c > 99 ? '99+' : c);
        if (c <= 0) badge.classList.add('hide-badge');
        else badge.classList.remove('hide-badge');
    }

    function updateNotificationsDashboardSummary() {
        var el = document.getElementById('dash-notif-summary');
        if (!el) return;

        var list = loadNotifications();
        var unread = unreadCount();

        if (unread === 0) {
            el.innerText = 'No unread alerts. You are up to date.';
            return;
        }

        // show most recent unread
        for (var i = 0; i < list.length; i++) {
            if (!list[i].read) {
                el.innerText = unread + ' unread alert(s). Latest: ' + list[i].title + '.';
                return;
            }
        }
    }

    function updateNotificationsHeader() {
        var cons = document.getElementById('notif-consumption');
        var lim = document.getElementById('notif-limit');
        var bill = document.getElementById('notif-est-bill');
        var pct = document.getElementById('notif-percent');
        var bar = document.getElementById('notif-progress-bar');
        var status = document.getElementById('notif-status-pill');
        var hint = document.getElementById('notif-hint');

        if (!cons || !lim || !bill || !pct || !bar || !status || !hint) return;

        cons.innerText = currentConsumptionM3.toFixed(2);
        lim.innerText = currentLimitM3.toFixed(2);

        // FIX: now changes smoothly with small consumption values
        bill.innerText = calculateWaterBill(currentConsumptionM3).toFixed(2);

        var percent = (currentLimitM3 <= 0) ? 0 : Math.min(999, (currentConsumptionM3 / currentLimitM3) * 100);
        var percentText = Math.round(percent) + '%';
        pct.innerText = percentText;

        var width = Math.max(0, Math.min(100, percent));
        bar.style.width = width + '%';

        // Status logic
        if (percent >= 100) {
            status.className = "inline-flex items-center gap-2 bg-red-50 text-red-600 px-3 py-1.5 rounded-full text-[9px] font-black uppercase tracking-widest border border-red-100";
            status.innerText = "Limit Reached";
            hint.innerText = "You have reached your set limit. Turning off unused faucets and reducing run-time helps prevent further cost spikes.";
        } else if (percent >= 95) {
            status.className = "inline-flex items-center gap-2 bg-amber-50 text-amber-600 px-3 py-1.5 rounded-full text-[9px] font-black uppercase tracking-widest border border-amber-100";
            status.innerText = "Very Close";
            hint.innerText = "Usage is very close to your limit. Reduce faucet run-time and check for leaks to stay within your target.";
        } else if (percent >= 80) {
            status.className = "inline-flex items-center gap-2 bg-amber-50 text-amber-600 px-3 py-1.5 rounded-full text-[9px] font-black uppercase tracking-widest border border-amber-100";
            status.innerText = "Approaching";
            hint.innerText = "You are approaching your limit. Shorten showers and avoid leaving faucets running between tasks.";
        } else {
            status.className = "inline-flex items-center gap-2 bg-emerald-50 text-emerald-600 px-3 py-1.5 rounded-full text-[9px] font-black uppercase tracking-widest border border-emerald-100";
            status.innerText = "On Track";
            hint.innerText = "Keep faucets off when not in use. Small habits reduce total consumption quickly.";
        }

        refreshSettingsUI();
    }

    function checkThresholdsAndNotify(silentIfAlready) {
        var alertsEnabled = localStorage.getItem('hytrack_alerts_enabled') === 'true';
        if (!alertsEnabled) return;

        if (currentLimitM3 <= 0) return;

        var percent = (currentConsumptionM3 / currentLimitM3) * 100;
        for (var i = 0; i < ALERT_LEVELS.length; i++) {
            var level = ALERT_LEVELS[i];
            if (percent >= level) {
                var flagKey = 'hytrack_threshold_' + level;
                var already = localStorage.getItem(flagKey) === 'true';
                if (!already) {
                    localStorage.setItem(flagKey, 'true');

                    if (level === 80) {
                        addNotification('limit', 'Approaching Bill Limit', 'You are at ' + Math.round(percent) + '% of your monthly target. Turn off faucets when not in use and watch for unnecessary flow.', 'warning');
                    } else if (level === 95) {
                        addNotification('limit', 'Bill Limit Nearly Reached', 'You are at ' + Math.round(percent) + '% of your monthly target. Reduce usage now to avoid exceeding your set limit.', 'danger');
                    } else if (level === 100) {
                        addNotification('limit', 'Monthly Limit Reached', 'You have reached 100% of your monthly target. Consider pausing non-essential water usage and checking for leaks.', 'danger');
                    }
                } else {
                    if (!silentIfAlready) {
                        // already notified
                    }
                }
            }
        }
    }

    function resetThresholdFlags() {
        for (var i = 0; i < ALERT_LEVELS.length; i++) {
            localStorage.removeItem('hytrack_threshold_' + ALERT_LEVELS[i]);
        }
    }

    function setConsumption(newVal) {
        currentConsumptionM3 = Math.max(0, newVal);
        localStorage.setItem('hytrack_consumption_m3', currentConsumptionM3.toFixed(2));
        updateDashboardValues();
        checkThresholdsAndNotify(true);
        updateNotificationBadge();
    }

    function simulateUsage(delta) {
        setConsumption(currentConsumptionM3 + (delta || 0));
        addNotification('usage', 'Consumption Updated', 'Consumption increased by ' + (delta || 0).toFixed(2) + ' m³. Monitor faucet usage to stay within your target.', 'info');
        renderNotifications();
        updateNotificationBadge();
    }

    function resetMonth() {
        setConsumption(0.00);
        resetThresholdFlags();

        // Clear notifications but keep a fresh seed
        localStorage.removeItem('hytrack_notifications');
        ensureSeedNotifications();

        addNotification('reset', 'New Month Started', 'Consumption has been reset to 0.00 m³. Your alerts are ready for the new billing cycle.', 'info');

        renderNotifications();
        updateNotificationBadge();
        updateNotificationsDashboardSummary();
    }

    function startFaucetSimulation() {
        stopFaucetSimulation();

        // Simulate consumption increase while faucet is on (prototype)
        // Adds 0.02 m³ every 5 seconds (adjust if needed)
        faucetFlowInterval = setInterval(function() {
            setConsumption(currentConsumptionM3 + 0.02);
        }, 5000);

        // Reminder if faucet stays on
        var minutes = parseInt(localStorage.getItem('hytrack_faucet_reminder_min') || '5', 10);
        faucetReminderTimeout = setTimeout(function() {
            addNotification('faucet', 'Turn Off the Faucet', 'The faucet has been left on for ' + minutes + ' minutes. Turn it off to prevent waste and avoid hitting your bill limit.', 'warning');
            renderNotifications();
            updateNotificationBadge();
        }, minutes * 60 * 1000);
    }

    function stopFaucetSimulation() {
        if (faucetFlowInterval) {
            clearInterval(faucetFlowInterval);
            faucetFlowInterval = null;
        }
        if (faucetReminderTimeout) {
            clearTimeout(faucetReminderTimeout);
            faucetReminderTimeout = null;
        }
    }

    // -----------------------------
    // CONTACTS UTILITIES (NEW)
    // -----------------------------
    function copyText(text) {
        try {
            navigator.clipboard.writeText(text);
        } catch(e) {
            // fallback
            var input = document.createElement('input');
            input.value = text;
            document.body.appendChild(input);
            input.select();
            document.execCommand('copy');
            document.body.removeChild(input);
        }

        var toast = document.getElementById('copy-toast');
        if (toast) {
            toast.classList.remove('hide-screen');
            setTimeout(function() {
                toast.classList.add('hide-screen');
            }, 1800);
        }
    }

    // -----------------------------
    // HELPERS
    // -----------------------------
    function escapeHtml(str) {
        if (str === undefined || str === null) return '';
        return String(str)
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll("'", '&#039;');
    }
</script>

